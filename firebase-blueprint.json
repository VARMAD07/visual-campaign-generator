{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A creative campaign project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "campaignType": { "type": "string", "enum": ["poster", "banner", "social_media", "event", "promo"] },
        "brandDetails": { "type": "string" },
        "visualStyle": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["name", "campaignType", "userId"]
    },
    "Asset": {
      "title": "Asset",
      "description": "A brand asset uploaded for a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "url", "name"]
    },
    "Variation": {
      "title": "Variation",
      "description": "A generated creative variation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "prompt": { "type": "string" },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "imageUrl"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "User projects"
    },
    "/projects/{projectId}/assets/{assetId}": {
      "schema": "Asset",
      "description": "Assets belonging to a project"
    },
    "/projects/{projectId}/variations/{variationId}": {
      "schema": "Variation",
      "description": "Generated variations for a project"
    }
  }
}
